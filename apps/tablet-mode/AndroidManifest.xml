<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tabletmode">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <application
        android:label="Tablet Mode"
        android:icon="@android:drawable/ic_menu_view"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">
        <activity
            android:name=".TabletModeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="density|screenSize|smallestScreenSize|orientation|screenLayout|fontScale|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.tabletmode.shizuku"
            android:exported="true"
            android:enabled="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
    </application>
</manifest>
